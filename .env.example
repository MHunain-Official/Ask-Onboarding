# App
APP_ENV=development
# Long random string used to sign session cookies. Change in every environment.
SECRET_KEY=change-me-long-random
DATABASE_URL=postgresql+psycopg://app:app@db:5432/askonboarding

# --- Answer generation via OpenRouter (OpenAI-compatible API) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Primary model; must support tool calling + streaming.
LLM_MODEL=openai/gpt-4o-mini
# Used when the primary fails; must also support tool calling.
LLM_FALLBACK_MODEL=openai/gpt-4o-mini

# --- Embeddings (prefer OpenAI direct; OpenRouter also works via the same SDK) ---
# Preferred: https://api.openai.com/v1 + text-embedding-3-small
# If OpenAI has no credits, you can point these at OpenRouter instead:
#   EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
#   EMBEDDING_MODEL=openai/text-embedding-3-small
#   EMBEDDING_API_KEY=<same as LLM_API_KEY>
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# Chunking / retrieval
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
HYBRID_ENABLED=true
# Tuned on the eval set; cosine similarity threshold for "no answer" gate.
MIN_SIMILARITY=0.30
MAX_UPLOAD_MB=10

# LLM generation limits
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=800
# Fill from the provider pricing page (USD per million tokens).
LLM_PRICE_INPUT_PER_MTOK=0.15
LLM_PRICE_OUTPUT_PER_MTOK=0.60

RATE_LIMIT_CHAT_PER_MINUTE=10
AUDIT_RETENTION_DAYS=90
SEED_ON_START=true

# --- Efficiency, cache and budgets ---
CACHE_ENABLED=true
CACHE_TTL_HOURS=72
# Enable only after the eval shows zero false hits on paraphrases.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.97
EXTRACTIVE_SHORTCUT_ENABLED=false
MAX_CONTEXT_TOKENS=3000
MAX_QUESTION_CHARS=1000
MAX_PDF_PAGES=300
DAILY_TOKEN_CAP_PER_USER=100000
# Global kill switch -> degraded retrieval-only mode.
DAILY_COST_CAP_USD=10
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Frontend (browser talks only to same-origin /api)
NEXT_PUBLIC_APP_NAME=Ask Onboarding
BACKEND_URL=http://backend:8000
PROMPT_VERSION=v1.1

# Repo root for the admin Docs tab (ARCHITECTURE, ADRs, walkthrough, rules).
# Leave empty locally to auto-detect via AGENTS.md. Docker Compose sets /app/repo.
PROJECT_DOCS_ROOT=

# --- Rate limiting (uploads) ---
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- Production only (docker-compose.prod.yml; ignored in local dev) ---
# Public hostname Caddy gets a certificate for, and the Let's Encrypt contact.
DOMAIN=
ACME_EMAIL=
# Database password. Must be set in production; local dev uses the compose default.
POSTGRES_PASSWORD=
